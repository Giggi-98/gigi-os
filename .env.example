# Copia in .env e adatta. Nessun segreto va in questo file: chiave master e certificato stanno in ./secrets.
GIGI_VERSION=0.2.0
# IP LAN su cui GIGI OS ascolta (mai 0.0.0.0)
GIGI_BIND=192.168.222.200
GIGI_PORT=8470
# GID del gruppo docker sull'host (getent group docker)
DOCKER_GID=128
# Container controllabili (start/stop/restart) dagli admin: * = tutti tranne gigi-agent e gigi-api
GIGI_CONTROL_ALLOW=*
# Reti raggiungibili dai connettori (difesa SSRF)
GIGI_ALLOWED_TARGETS=127.0.0.0/8,::1/128,192.168.222.0/24
GIGI_LOG_LEVEL=warn
