# Copia in .env e adatta. Nessun segreto va in questo file: chiave master e certificato stanno in ./secrets.
GIGI_VERSION=0.3.1

# ── Rete ──
# IP LAN del server su cui GIGI OS ascolta (obbligatorio, mai 0.0.0.0). Es.: ip -4 addr show
GIGI_BIND=192.168.1.20
GIGI_PORT=8470
# Reti raggiungibili dai connettori (difesa SSRF). Vuoto = 127.0.0.1 più la rete LAN dell'IP in GIGI_BIND
GIGI_ALLOWED_TARGETS=

# ── Permessi sull'host ──
# GID del gruppo docker (getent group docker | cut -d: -f3)
DOCKER_GID=999
# GID del gruppo systemd-journal (getent group systemd-journal | cut -d: -f3)
JOURNAL_GID=101
# Container controllabili (start/restart) da admin e operatori: * = tutti tranne quelli di GIGI OS
GIGI_CONTROL_ALLOW=*

# ── Cartelle ──
# Radice di download e media: montata con lo stesso percorso in gigi-media e gigi-files (gli hardlink richiedono un solo mount)
GIGI_MEDIA_ROOT=/srv
# Cartelle reali delle librerie Jellyfin in cui importare (film, serie, film anime, serie anime)
GIGI_MEDIA_LIBRARIES=movies=/srv/media/Movies,series=/srv/media/TV,animeMovies=/srv/media/Anime/Movies,animeSeries=/srv/media/Anime/TV
# Radici del file manager: Nome=/percorso, separate da virgole (dentro GIGI_MEDIA_ROOT)
GIGI_FILES_ROOTS=Download=/srv/downloads,Media=/srv/media
# Dove il wizard crea i nuovi stack compose
GIGI_STACKS_ROOT=/opt/stacks
# Cartelle extra da non far montare agli stack senza conferma (quelle degli stack esistenti si riconoscono da sole)
GIGI_PROTECTED_PATHS=

# ── Varie ──
GIGI_LOG_LEVEL=warn
# Giorni di storico delle metriche (host, container, dischi), 1–365
GIGI_METRICS_DAYS=30
# Fuso orario di backup, ore di silenzio e digest (il container altrimenti usa UTC)
GIGI_TZ=Europe/Rome
# Repo GitHub «owner/nome» da cui controllare le nuove versioni di GIGI OS (vuoto = nessun controllo).
# install.sh la ricava dal remote «origin»; per aggiornare: sudo ./update.sh
GIGI_RELEASE_REPO=Giggi-98/gigi-os
